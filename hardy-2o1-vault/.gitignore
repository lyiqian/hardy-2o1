# ==============================================================================
# Obsidian Dynamic Workspace & Caches (HIGH CONFLICT RISK)
# ==============================================================================
# Tracks open tabs, active pane state, split positions, and window sizes.
# ALWAYS ignore this to prevent endless merge conflicts across desktop/mobile.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Local workspace backups & cache databases
.obsidian/workspace*.json
.obsidian/graph.json
.obsidian/starred.json
.obsidian/backups/
.obsidian/cache/

# ==============================================================================
# Device-Specific Plugin Storage & Index Caches
# ==============================================================================
# Local caches generated by heavy community plugins (e.g., Dataview, Omnisearch)
.obsidian/plugins/**/data.json.bak
.obsidian/plugins/**/cache/
.obsidian/plugins/**/index/
.obsidian/plugins/omnisearch/
.obsidian/plugins/obsidian-textgenerator-plugin/

# Obsidian Git mobile/desktop persistent state
.obsidian/plugins/obsidian-git/data.json
